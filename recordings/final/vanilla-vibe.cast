[0.033, "o", "\u001b[?2026h\u001b[30A\t\t \u001b[34;4m\u001b]8;id=jk818014787141fc6;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/README.md\u0007xiao-rp2350-bargraph/\u001b[m\u001b]8;;\u0007\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\u001b[34;4m\u001b]8;id=jka0131466c1cf7b16;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/Makefile\u0007xiao-rp2350-bargraph/Makefile\u001b[m\u001b]8;;\u0007\r\n\n\n\t\u001b[34;4m\u001b]8;id=jk817ff4787141c60;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/README.md\u0007xiao-rp2350-bargraph/README.md\u001b[m\u001b]8;;\u0007\n\n\u001b[52C2350-bargraph/include/ba\r\n\n\n\n\u001b[2C\u001b[?2026l"]
[0.016, "o", "\u001b[?2026h\r\u001b[33A\u001b[K\r\n\u001b[32m●\u001b[m \u001b[1;33mRan\u001b[m 2 commands \u001b[37m(\u001b[m\u001b[37marm-none-eabi-nm /Us...\u001b[m\u001b[37m · \u001b[m\u001b[37mmake -C /Users/brett...\u001b[m\u001b[37m)\u001b[m \u001b[37m(ctrl+o to expand)\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\n  The out-of-tree Apache NuttX application and custom Seeed Studio XIAO RP2350 board configuration have been\r\n  implemented in \u001b[34;4m\u001b]8;id=jkec4ae3bb88085480;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/README.md\u0007xiao-rp2350-bargraph/\u001b[m\u001b]8;;\u0007.\r\n\n  \u001b[1m### Breadboard Pinout (Seeed Studio XIAO RP2350)\u001b[m\r\n\n  All 6 bar-graph LEDs are placed on non-ADC digital pins (\u001b[94mD3\u001b[m–\u001b[94mD8\u001b[m) because \u001b[94mrp23xx_adc.c\u001b[m resets \u001b[94mGPIO26\u001b[m–\u001b[94mGPIO29\u001b[m (\u001b[94mD0\u001b[m–\u001b[94mD2\u001b[m)\r\n  to analog mode (\u001b[94mRP23XX_GPIO_FUNC_NULL\u001b[m) when initializing the ADC peripheral:\r\n\n   Function\u001b[19X\u001b[19C│ XIAO Pad  │ RP2350 GPIO   │ Active Polarity / Notes\r\n  ────────────────────────────┼───────────┼──────"]
[0.0, "o", "─────────┼──────────────────────────────────────────────────────────\r\n   \u001b[1mPotentiometer Wiper\u001b[m \u001b[7b│ \u001b[1mD0 / A0\u001b[m   │ \u001b[94mGPIO26\u001b[m (\u001b[94mADC0\u001b[m) │ \u001b[94m0 V\u001b[m (\u001b[94mGND\u001b[m) to \u001b[94m3.3 V\u001b[m (\u001b[94m3V3\u001b[m), read via \u001b[94m/dev/adc0\u001b[m\r\n   \u001b[1mBar LED 1\u001b[m (lowest, ≥ 14%)  │ \u001b[1mD3\u001b[m \u001b[7b│ \u001b[94mGPIO5\u001b[m \u001b[8b│ Active-high (\u001b[94mGPIO -> 220..330 Ω -> Anode\u001b[m, Cathode to \u001b[94mGND\u001b[m)\r\n   \u001b[1mBar LED 2\u001b[m (≥ 28%) \u001b[9b│ \u001b[1mD4\u001b[m \u001b[7b│ \u001b[94mGPIO6\u001b[m \u001b[8b│ Active-high\r\n   \u001b[1mBar LED 3\u001b[m (≥ 43%) \u001b[9b│ \u001b[1mD5\u001b[m \u001b[7b│ \u001b[94mGPIO7\u001b[m \u001b[8b│ Active-high\r\n   \u001b[1mBar LED 4\u001b[m (≥ 57%) \u001b[9b│ \u001b[1mD6\u001b[m \u001b[7b│ \u001b[94mGPIO0\u001b[m \u001b[8b│ Active-high\r\n   \u001b[1mBar LED 5\u001b[m (≥ 71%) \u001b[9b│ \u001b[1mD7\u001b[m \u001b[7b│ \u001b[94mGPIO1\u001b[m \u001b[8b│ Active-high\r\n   \u001b[1mBar LED 6\u001b[m (highest, ≥ 86%) │ \u001b[1mD8\u001b[m \u001b[7b│ \u001b[94mGPIO2\u001b[m \u001b[8b│ Active-high\r\n   \u001b[1mOnboard Status"]
[0.0, "o", " LED\u001b[m \u001b[8b│ \u001b[3m(Onboard)\u001b[m │ \u001b[94mGPIO25\u001b[m \u001b[7b│ Active-low yellow user LED (driven by NuttX \u001b[94mARCH_LEDS\u001b[m)\r\n  ──────\r\n  \u001b[1m### Architecture & Key Files\u001b[m\r\n\n  • \u001b[1mOut-of-Tree Build & Test Driver\u001b[m:\n\u001b[30D• \u001b[34;4m\u001b]8;id=jkd9546d8fda691640;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/Makefile\u0007xiao-rp2350-bargraph/Makefile\u001b[m\u001b]8;;\u0007: Runs host unit tests (\u001b[94mmake -C xiao-rp2350-bargraph test\u001b[m) and builds the NuttX\r\n\u001b[6CUF2 firmware (\u001b[94mmake -C xiao-rp2350-bargraph\u001b[m) into \u001b[94mnuttx/nuttx.uf2\u001b[m using \u001b[94mCONFIG_ARCH_BOARD_CUSTOM\u001b[m and the\r\n\u001b[6Cgitignored \u001b[94mapps/external\u001b[m symlink so \u001b[94mnuttx/\u001b[m and \u001b[94mapps/\u001b[m remain untouched.\n\u001b[70D• \u001b[34;4m\u001b]8;id=jkec4ae5bb880857e6;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/README.md\u0007xiao-rp2350-bargraph/README.md\u001b[m\u001b]8;;\u0007: Wiring diagram, build instructions, and NSH command reference.\r\n  • \u001b[1mPure Bar-Graph Logic & Host Unit Tests\u001b[m:\n\u001b[37D• \u001b[34;4m\u001b]"]
[0.0, "o", "8;id=jk8421e7da8d454947;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/include/bargraph_logic.h\u0007xiao-rp2350-bargraph/include/bargraph_logic.h\u001b[m\u001b]8;;\u0007 & [bargr\r\n\n\n⣟  \u001b[94mGe\u001b[90mnerating...\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[77X\u001b[77C\u001b[33mauto\u001b[39;2m"]
