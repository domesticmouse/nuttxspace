[0.0, "o", ";34;4m2\u001b[m\u001b[4;34;4m3\u001b[m\u001b[4;34;4m5\u001b[m\u001b[4;34;4m0\u001b[m\u001b[4;34;4m-\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mh\u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mh\u001b[m\u001b[4;34;4m_\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4mc\u001b[m\u001b]8;;\u001b\\: Decodes RP2350\u001b[K\r\n      left-shifted 12-bit ADC samples (\u001b[94msample >> 19\u001b[m), applies exponential moving average (EMA) smoothing (α = 1/4)\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Cand hysteresis deadband filtering (±48 counts), maps \u001b[94m0..4095\u001b[m into \u001b[94m0..6\u001b[m LEDs (\u001b[94m0x00..0x3f\u001b[m bitmask), and formats\r\n\u001b[6CASCII status output.\n\u001b[20D• \u001b[34;4m\u001b]8;id=jk70981d48069d8ebd;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/tests/test_bargraph.c\u0007xiao-rp2350-bargraph/tests/test_bargraph.c\u001b[m\u001b]8;;\u0007: Host unit tests verifying ADC decoding, threshold edges,\r\n\u001b[6C"]
[0.0, "o", "hysteresis stability, and full-range sweeps.\r\n  • \u001b[1mOut-of-Tree NuttX Application (\u001b[94;22mbargraph\u001b[39;1m)\u001b[m:\n\u001b[39D• \u001b[34;4m\u001b]8;id=jkaaa179cbe1f87b3e;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/apps/bargraph/bargraph_main.c\u0007xiao-rp2350-bargraph/apps/bargraph/bargraph_main.c\u001b[m\u001b]8;;\u0007: Implements \u001b[94mbargraph_autostart()\u001b[m (spawning the \u001b[94mbargraph_d\u001b[m\r\n\u001b[6Cdaemon task that polls \u001b[94m/dev/adc0\u001b[m every 25 ms and updates \u001b[94m/dev/userleds\u001b[m via \u001b[94mULEDIOC_SETALL\u001b[m) and the interactive\r\n\u001b[6C\u001b[94mbargraph [start|status|once|stop]\u001b[m NSH command.\r\n  • \u001b[1mCustom XIAO RP2350 Board Configuration\u001b[m:\n\u001b[37D• \u001b[34;4m\u001b]8;id=jk543fb93fb5278efe;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/board/include/board.h\u0007xiao-rp2350-bargraph/board/include/board.h\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jka3d63ba37e6ef7e1;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/board/src/rp23xx_userleds.c\u0007xiao-rp2350-bargraph/board/src/rp23xx_"]
[0.0, "o", "userleds.c\u001b[m\u001b]8;;\u0007: Defines the 6\r\n\u001b[6Cbreadboard LED pins (\u001b[94mD3\u001b[m–\u001b[94mD8\u001b[m) for \u001b[94m/dev/userleds\u001b[m.\n\u001b[46D• \u001b[34;4m\u001b]8;id=jk20f4e0547b5c2ef7;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/board/src/rp23xx_bringup.c\u0007xiao-rp2350-bargraph/board/src/rp23xx_bringup.c\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jk25edcc710fb12ae0;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/board/src/rp23xx_romfs.c\u0007xiao-rp2350-bargraph/board/src/rp23xx_romfs.c\u001b[m\u001b]8;;\u0007: Registers\r\n\u001b[6C\u001b[94m/dev/adc0\u001b[m (\u001b[94mADC0\u001b[m on \u001b[94mGPIO26\u001b[m), \u001b[94m/dev/userleds\u001b[m, and \u001b[94m/etc/init.d/rcS\u001b[m, and starts the \u001b[94mbargraph_d\u001b[m background daemon\r\n\u001b[6Cimmediately at boot before USB CDC-ACM serial attaches (\u001b[94m# CONFIG_DEV_CONSOLE is not set\u001b[m +\n\u001b[89D\u001b[94mCONFIG_NSH_USBCONSOLE=y\u001b[m).\n\u001b[25D• \u001b[34;4m\u001b]8;id=jk9e88081c758bef8f;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/board/configs/bargraph/defconfig\u0007xiao-rp2350-bargraph/board/configs/bargraph/defcon"]
[0.0, "o", "fig\u001b[m\u001b]8;;\u0007: Board configuration enabling RP2350 ADC, \u001b[94m/dev/userleds\u001b[m,\r\n\u001b[6CUSB CDC-ACM console, ROMFS startup scripts, and \u001b[94mCONFIG_XIAO_RP2350_BARGRAPH=y\u001b[m.\r\n\n  ──────\r\n  \u001b[1m### Commands Verified\u001b[m\r\n\n  1. \u001b[1mHost Unit Tests\u001b[m:\n\u001b[17D\u001b[38;5;252mmake -C xiao-rp2350-bargraph \u001b[38;5;31mtest\u001b[m\r\n\n  2. \u001b[1mFirmware Build\u001b[m:\n\u001b[16D\u001b[38;5;252mmake -C xiao-rp2350-bargraph\u001b[m\r\n  Generates \u001b[34;4m\u001b]8;id=jk48dbdf9ee122e973;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/nuttx/nuttx.uf2\u0007nuttx/nuttx.uf2\u001b[m\u001b]8;;\u0007.\r\n  3. \u001b[1mInteractive NSH Usage\u001b[m (once connected to \u001b[94m/dev/tty.usbmodem*\u001b[m at \u001b[94m115200 8N1\u001b[m, press \u001b[1mEnter\u001b[m three times):\r\n\u001b[4C\u001b[38;5;252mn\u001b[m\r\n\n\n⣯  \u001b[90mWo\u001b[94mrking\u001b[90m...\u001b[m\r\n\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────"]
