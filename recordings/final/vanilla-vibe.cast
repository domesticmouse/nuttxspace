[0.0, "o", "\u001b[32m●\u001b[m \u001b[33;1mEdited\u001b[m 3 files \u001b[37m(defconfig, defconfig, Makefile)\u001b[m\r\n\u001b[32m●\u001b[m \u001b[33;1mRan\u001b[m \u001b[37m(make -C /Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph -j4)\u001b[m \u001b[37m(ctrl+o to expand)\u001b[m\r\n\n  Rebuilding the NuttX firmware with \u001b[94mCONFIG_ANALOG=y\u001b[m enabled so the RP2350 ADC driver and \u001b[94mbargraph\u001b[m application are\r\n  registered and linked; waiting for the build to complete.\r\n\n\u001b[32m●\u001b[m \u001b[33;1mRan\u001b[m 2 commands \u001b[37m(arm-none-eabi-nm /Us... · make -C /Users/brett...)\u001b[m \u001b[37m(ctrl+o to expand)\u001b[m\r\n\n  The out-of-tree Apache NuttX application and custom Seeed Studio XIAO RP2350 board configuration have been\r\n  implemented in \u001b[34;4m\u001b]8;id=jk4e10ac9cccc237ca;file:///Users/brett/Documents/GitHub/nuttxspace-vanilla/xiao-rp2350-bargraph/README.md\u0007xiao-rp2350-bargraph/\u001b[m\u001b]8;;\u0007.\r\n\n  \u001b[1m### Breadboard Pinout (Seeed Studio XIAO RP2350)\u001b[m\r\n\n  All 6 bar-graph LEDs are placed on non-ADC digital pins (\u001b[94mD3\u001b[m–\u001b[94mD8\u001b[m) because \u001b[94mrp23xx_adc.c\u001b[m resets \u001b[94mGPIO26\u001b[m"]
[0.0, "o", "–\u001b[94mGPIO29\u001b[m (\u001b[94mD0\u001b[m–\u001b[94mD2\u001b[m)\r\n  to analog mode (\u001b[94mRP23XX_GPIO_FUNC_NULL\u001b[m) when initializing the ADC peripheral:\r\n\n   Function \u001b[12b│ XIAO Pad \u001b[12b│ RP2350 GPIO \u001b[9b│ Active Polarity / Notes\r\n  ──────────────────────┼──────────────────────┼──────────────────────┼──────────────────────────────────────────────\r\n   \u001b[1mPotentiometer Wiper\u001b[m  │ \u001b[1mD0 / A0\u001b[m\u001b[14X\u001b[14C│ \u001b[94mGPIO26\u001b[m (\u001b[94mADC0\u001b[m) \u001b[7b│ \u001b[94m0 V\u001b[m (\u001b[94mGND\u001b[m) to \u001b[94m3.3 V\u001b[m (\u001b[94m3V3\u001b[m), read via \u001b[94m/dev/adc0\u001b[m\r\n   \u001b[1mBar LED 1\u001b[m (lowest,   │\u001b[22X\u001b[22C│\u001b[22X\u001b[22C│\r\n⣟  \u001b[90mLo\u001b[94mading\u001b[90m...\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────"]
