[0.000, "o", " built-in user-\r\n  space application (\u001b[94mxiao-rp2350-bargraph/apps/bargraph/\u001b[m) for the Seeed Studio XIAO RP2350 with zero modifications to\r\n  \u001b[94mnuttx/\u001b[m or \u001b[94mapps/\u001b[m.\r\n  • \u001b[1mHardware Mapping\u001b[m:\n\u001b[15D• Potentiometer input on \u001b[94mD0/A0\u001b[m (\u001b[94mGPIO26\u001b[m, \u001b[94m/dev/adc0\u001b[m channel 0).\n\u001b[61D• Six active-high LEDs on \u001b[94mD1\u001b[m–\u001b[94mD6\u001b[m (\u001b[94mGPIO27\u001b[m/\u001b[94mPWM5B\u001b[m, \u001b[94mGPIO28\u001b[m/\u001b[94mPWM6A\u001b[m, \u001b[94mGPIO5\u001b[m/\u001b[94mPWM2B\u001b[m, \u001b[94mGPIO6\u001b[m/\u001b[94mPWM3A\u001b[m, \u001b[94mGPIO7\u001b[m/\u001b[94mPWM3B\u001b[m,\n\u001b[99D\u001b[94mGPIO0\u001b[m/\u001b[94mPWM0A\u001b[m).\r\n  • \u001b[1mKey Architectural & Driver Constraints\u001b[m:\n\u001b[37D• Enable \u001b[94mCONFIG_BOARD_LATE_INITIALIZE=y\u001b[m and dual multi-channel PWM Kconfig symbols (\u001b[94mCONFIG_PWM_MULTICHAN=y\u001b[m,\r\n\u001b[6C\u001b[94mCONFIG_PWM_NCHANNELS=2\u001b[m, \u001b[94mCONFIG_RP23XX_PWM_MULTICHAN=y\u001b[m, \u001b[94mCONFIG_RP23XX_PWM_NCHANNELS=2\u001b[m) with unused sibling pins\r\n\u001b[6Cset to \u001b[94m-1\u001b[m.\n\u001b[10D• Populate both \u001b[94mchannels[0]\u001b[m (channel 1 / pin A) and \u001b[94mchannels[1]\u001b[m (channel 2 / pin B) on multi-channel PWM sli"]
[0.000, "o", "ces,\r\n\u001b[6Cscale duty strictly within \u001b[94m0..65535\u001b[m (\u001b[94muint16_t\u001b[m), and zero duty before \u001b[94mPWMIOC_STOP\u001b[m.\n\u001b[81D• Enable only \u001b[94mCONFIG_RP23XX_ADC_CHANNEL0=y\u001b[m, configure \u001b[94mRP23XX_PADS_BANK0_GPIO(26)\u001b[m (\u001b[94mIE=0\u001b[m, \u001b[94mPUE=0\u001b[m, \u001b[94mPDE=0\u001b[m, \u001b[94mISO=0\u001b[m,\r\n\u001b[6C\u001b[94mOD=1\u001b[m) for Erratum RP2350-E9, pace hardware conversions via \u001b[94mRP23XX_ADC_DIV = 0xFFFF00\u001b[m (\u001b[94m~732 Hz\u001b[m), flush stale\r\n\u001b[6CFIFO samples with \u001b[94mANIOC_RESET_FIFO\u001b[m, and right-shift \u001b[94mam_data >> 19\u001b[m.\n\u001b[66D• Spawn \u001b[94mbargraphd\u001b[m autonomously from \u001b[94mrp23xx_bringup()\u001b[m before USB-C NSH console initialization, and provide the\r\n\u001b[6C\u001b[94mba\u001b[m\r\n\n⣯  \u001b[90mLoadi\u001b[94mng...\u001b[m\r\n\u001b[90m───────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
