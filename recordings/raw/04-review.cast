[0.000, "o", "graph_main.c\u001b[m)\u001b[K\r\n  • \u001b[1mDescription:\u001b[m\u001b[K\r\n      1. \u001b[94mMAINSRC\u001b[39;1m \u001b[94;22m-Dmain=bargraph_main\u001b[39;1m Rule\u001b[m: \u001b[34;4m\u001b]8;id=jkefe51e53f670614a;file:///Users/brett/Documents/GitHub/nuttxspace-egm/apps/Application.mk#L353-L357\u0007apps/Application.mk:353-357\u001b[m\u001b]8;;\u0007 compiles \u001b[94mMAINSRC = bargraph_main.c\u001b[m with \u001b[94m-\u001b[m\r\n\u001b[6C\u001b[94mDmain=$(PROGSYM)_main\u001b[m (\u001b[94m-Dmain=bargraph_main\u001b[m). Target File #30 should explicitly specify defining \u001b[94mint main(int\u001b[m\r\n\u001b[6C\u001b[94margc, FAR char *argv[])\u001b[m in \u001b[94mbargraph_main.c\u001b[m (rewritten to \u001b[94mbargraph_main\u001b[m by the preprocessor).\u001b[K\n\u001b[92D2. \u001b[1mHedged Modifiers & Wait Mechanism\u001b[m: Line 526 hedges \u001b[94m\"weak/conditional\"\u001b[m, line 657 hedges \u001b[94m(when not yet started\u001b[m\r\n\u001b[6C\u001b[94mor on update)\u001b[m for \u001b[94mPWMIOC_START\u001b[m, and line 664 hedges \u001b[94mpthread_cond_timedwait() (CLOCK_REALTIME or usleep + mutex\u001b[m\u001b[K\r\n\u001b[6C\u001b[94mlock)\u001b[m.\u001b[K\n\u001b[6D3. \u001b[1mMissing Initialization & Telemetry Specifications\u001b[m: Target File #30 omits \u001b[94mPTHREAD_MUTEX_INITIALIZER\u001b["]
