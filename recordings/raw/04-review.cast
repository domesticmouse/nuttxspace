[0.000, "o", "[94mPWMIOC_START\u001b[m, and line 664 hedges \u001b[94mpthread_cond_timedwait() (CLOCK_REALTIME or usleep + mutex\u001b[m\u001b[K\r\n\u001b[6C\u001b[94mlock)\u001b[m.\u001b[K\n\u001b[6D3. \u001b[1mMissing Initialization & Telemetry Specifications\u001b[m: Target File #30 omits \u001b[94mPTHREAD_MUTEX_INITIALIZER\u001b[m /\r\n\u001b[6C\u001b[94mPTHREAD_COND_INITIALIZER\u001b[m initialization of \u001b[94mg_bargraph\u001b[m, startup failure cleanup in \u001b[94mbargraphd_daemon()\u001b[m (closing\r\n\u001b[6Copened fds, setting \u001b[94minit_err\u001b[m, broadcasting \u001b[94mdone_cond\u001b[m), exact integer formulas for \u001b[94mmillivolts\u001b[m, \u001b[94mpermille\u001b[m, and\u001b[K\r\n\u001b[6C\u001b[94mtotal_units\u001b[m across \u001b[94mSENSING\u001b[m/\u001b[94mMANUAL\u001b[m/\u001b[94mTEST\u001b[m modes, and the exact \u001b[94mprintf\u001b[m format layout for \u001b[94mbargraph status\u001b[m.\u001b[K\r\n\u001b[6C4. \u001b[1mAltitude Duplication\u001b[m: \u001b[94mFeatureRange\u001b[m Section 5 (lines 303–332) embeds the full low-level C declaration of \u001b[94menum\u001b[m\r\n\u001b[6C\u001b[94mbargraph_mode_e\u001b[m and \u001b[94mstruct bargraph_state_s\u001b[m, which duplicates \u001b[94mDetailedRange\u001b[m Target File #29 (\u001b[94mbargraph_internal.\u001b[m\r\n\u001b[6C\u001b[94mh\u001b[m).\u001b[K\r\n  • \u001b[1m"]
