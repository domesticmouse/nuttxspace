[0.016, "o", "\u001b[?2026h\r\u001b[33A\u001b[K\n  \u001b[1m### Breakdown Item 4 (of 12): Calibrate \u001b[94mrp23xx_adc.c\u001b[39m (\u001b[94mmy_reset()\u001b[39m), \u001b[94mrp23xx_pwm.c\u001b[39m (\u001b[94msetup_period()\u001b[39m, \u001b[94mpwm_stop()\u001b[39m, \u001b[94mpin\u001b[39m   \u001b[m\r\n  \u001b[1msignedness), \u001b[94mdrivers/timers/pwm.c\u001b[39m, and \u001b[94mnsh_main.c\u001b[39m Codebase Claims [\u001b[94megm-codebase-details\u001b[39m / \u001b[94megm-design\u001b[39m / \u001b[94megm-style\u001b[39m]\u001b[m\r\n\u001b[K\n  • \u001b[1mScope:\u001b[m \u001b[34;4m\u001b]8;id=jkb1200d6e10fc5bcd;file:///Users/brett/Documents/GitHub/nuttxspace-egm/docs/designs/xiao-rp2350-bargraph.md#L21-L24\u0007Lines 21–24\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk4ff9ae8db8b7070c;file:///Users/brett/Documents/GitHub/nuttxspace-egm/docs/designs/xiao-rp2350-bargraph.md#L236-L237\u0007Lines 236–237\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk87f91058dc5992cd;file:///Users/brett/Documents/GitHub/nuttxspace-egm/docs/designs/xiao-rp2350-bargraph.md#L266-L270\u0007Lines 266–270\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk74ec61de35d87353;file:///Users/brett/Documents/GitHub/nuttxspace-egm/docs/designs/xiao-rp2350-bargraph.md#L279-L280\u0007Lines 279–280\u001b[m\u001b]"]
[0.000, "o", "8;;\u0007, \u001b[34;4m\u001b]8;id=jk9c053358ae38bebc;file:///Users/brett/Documents/GitHub/nuttxspace-egm/docs/designs/xiao-rp2350-bargraph.md#L364\u0007Line 364\u001b[m\u001b]8;;\u0007 (\u001b[94m## The Problem\u001b[m, \u001b[94m### 4.1 ADC Subsystem\u001b[m\r\n  \u001b[94mMitigations\u001b[m, \u001b[94m### 4.2 Hardware PWM Subsystem Mitigations\u001b[m, \u001b[94m### Alternative C\u001b[m)\u001b[K\r\n  • \u001b[1mDescription:\u001b[m Six codebase descriptions in the document differ from the upstream \u001b[94mnuttx/\u001b[m and \u001b[94mapps/\u001b[m C source files:\r\n\u001b[6C1. \u001b[94mmy_reset()\u001b[39;1m in \u001b[94;22mrp23xx_adc.c\u001b[39;1m (lines 24, 236–237)\u001b[m: The text states \u001b[94mmy_reset()\u001b[m iterates over \u001b[3menabled\u001b[m ADC\r\n\u001b[6Cchannels and overwrites \u001b[94mD1\u001b[m/\u001b[94mD2\u001b[m PWM pin muxing set during \u001b[94mrp23xx_common_bringup()\u001b[m. In\u001b[K\n\u001b[83D\u001b[34;4m\u001b]8;id=jkf6d7a174e3de02f3;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_adc.c#L466-L483\u0007nuttx/arch/arm/src/rp23xx/rp23xx_adc.c:466-483\u001b[m\u001b]8;;\u0007, \u001b[94mmy_reset()\u001b[m loops unconditionally over all four ADC GPIOs (\u001b[94m26,\u001b[m\r\n\u001b[6C\u001b[94m27, 28, 29\u001b[m"]
[0.000, "o", "), setting them to \u001b[94mRP23XX_GPIO_FUNC_NULL\u001b[m during \u001b[94madc_register()\u001b[m. Meanwhile, \u001b[94mrp23xx_pwm_initialize()\u001b[m\u001b[K\r\n\u001b[6Cdoes not mux GPIOs during \u001b[94mrp23xx_common_bringup()\u001b[m; \u001b[94mpwm_setup()\u001b[m (\u001b[34;4m\u001b]8;id=jkeefdc94d8596ab30;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c#L214-L222\u0007nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c:214-222\u001b[m\u001b]8;;\u0007)\r\n\u001b[6Cconfigures \u001b[94mRP23XX_GPIO_FUNC_PWM\u001b[m later when \u001b[94mbargraphd\u001b[m calls \u001b[94mopen(\"/dev/pwm5\", ...)\u001b[m and \u001b[94mopen(\"/dev/pwm6\", ...)\u001b[m.\r\n\u001b[6CDisabling \u001b[94mADC_CHANNEL1..3\u001b[m and \u001b[94mADC_TEMPERATURE\u001b[m in \u001b[94mdefconfig\u001b[m is required so \u001b[94mget_next_channel()\u001b[m\u001b[K\n\u001b[92D(\u001b[34;4m\u001b]8;id=jke6f0a8a0a89d00d4;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_adc.c#L267\u0007nuttx/arch/arm/src/rp23xx/rp23xx_adc.c:267\u001b[m\u001b]8;;\u0007) only samples channel 0 instead of round-robin multiplexing\r\n\u001b[6Cchannels 1–4 into \u001b[94m/dev/adc0\u001b[m.\u001b[K\n\u001b[28D2. \u001b[94mdrivers/timers/pwm.c\u001b[39;1m \u001b[94;22"]
[0.000, "o", "mchannel == 0\u001b[39;1m claim (lines 21, 268)\u001b[m: \u001b[34;4m\u001b]8;id=jkfad82ea647d7283a;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/drivers/timers/pwm.c#L355-L376\u0007nuttx/drivers/timers/pwm.c:355-376\u001b[m\u001b]8;;\u0007 copies \u001b[94mstruct\u001b[m\u001b[K\r\n\u001b[6C\u001b[94mpwm_info_s\u001b[m verbatim via \u001b[94mmemcpy()\u001b[m without inspecting \u001b[94mchannel\u001b[m; the \u001b[94mchannel == 0\u001b[m (skip) / \u001b[94m-1\u001b[m (terminate) sentinel\r\n\u001b[6Cis the upper-half API contract in \u001b[34;4m\u001b]8;id=jk6bf9491b98a5e63b;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/include/nuttx/timers/pwm.h#L67-L70\u0007nuttx/include/nuttx/timers/pwm.h:67-70\u001b[m\u001b]8;;\u0007 (and enforced by\n\u001b[89D\u001b[94mapps/examples/pwm/pwm_main.c\u001b[m).\u001b[K\n\u001b[30D3. \u001b[1m1 kHz PWM \u001b[94;22mDIV\u001b[39;1m and \u001b[94;22mTOP\u001b[39;1m values (line 269)\u001b[m: In \u001b[94msetup_period()\u001b[m (\u001b[34;4m\u001b]8;id=jk2006bb50fb40cb62;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c#L486-L530\u0007nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c:486-530\u001b[m\u001b]8;;\u0007),\r\n\u001b[6C\u001b[94minfo.frequency = 1000\u001b[m at \u001b[94m150 M"]
[0.000, "o", "Hz\u001b[m computes \u001b[94mdiv16 = (16ULL * 150\u001b[6b) / (1000 * 65536) = 36\u001b[m (\u001b[94m0x24\u001b[m, divider \u001b[94m2.25\u001b[m\r\n\u001b[6Cin 8.4 fixed-point) and keeps \u001b[94mTOP = 65535\u001b[m (\u001b[94m0xffff\u001b[m), rather than \u001b[94mDIV = 16, TOP = 9374\u001b[m.\u001b[K\n\u001b[85D4. \u001b[1mSigned \u001b[94;22mpriv->pin[i]\u001b[39;1m check (line 266)\u001b[m: In \u001b[34;4m\u001b]8;id=jk722ca747b2c1b2eb;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_pwm.h#L53\u0007nuttx/arch/arm/src/rp23xx/rp23xx_pwm.h:53\u001b[m\u001b]8;;\u0007, \u001b[94mpriv->pin[i]\u001b[m is signed\r\n\u001b[6C\u001b[94mint8_t\u001b[m, and \u001b[94mpwm_setup()\u001b[m checks \u001b[94mif (priv->pin[i] >= 0)\u001b[m (not \u001b[94m>= 30\u001b[m unsigned).\u001b[K\n\u001b[75D5. \u001b[94mpwm_stop()\u001b[39;1m vs. \u001b[94;22mpwm_shutdown()\u001b[39;1m (lines 23, 280)\u001b[m: \u001b[94mpwm_stop()\u001b[m clears \u001b[94m1 << priv->num\u001b[m in \u001b[94mRP23XX_PWM_EN\u001b[m via\u001b[K\r\n\u001b[6C\u001b[94mclear_enabled()\u001b[m (\u001b[34;4m\u001b]8;id=jk8390c2971d6dbca8;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c#L643-L650\u0007nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c:643-650\u001b[m\u001b]8;;\u0007), leaving the p"]
[0.000, "o", "ad frozen while the device\u001b[K\r\n\u001b[6Cremains open, whereas \u001b[94mpwm_shutdown()\u001b[m on \u001b[94mclose()\u001b[m (\u001b[34;4m\u001b]8;id=jkd8bc14d9a2036d36;file:///Users/brett/Documents/GitHub/nuttxspace-egm/nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c#L249-L318\u0007nuttx/arch/arm/src/rp23xx/rp23xx_pwm.c:249-318\u001b[m\u001b]8;;\u0007) switches the\r\n\u001b[6Cpins to \u001b[94mRP23XX_GPIO_FUNC_SIO\u001b[m and drives them low (\u001b[94m0\u001b[m).\u001b[K\n\u001b[53D6. \u001b[94mnsh_main.c\u001b[39;1m startup sequence (line 364)\u001b[m: In \u001b[34;4m\u001b]8;id=jkad2541b49d5542a8;file:///Users/brett/Documents/GitHub/nuttxspace-egm/apps/system/nsh/nsh_main.c#L71-L76\u0007apps/system/nsh/nsh_main.c:71-76\u001b[m\u001b]8;;\u0007\n\n\n\n\u001b[82D\u001b[?2026l"]
